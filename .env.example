# AuroraAgent 环境变量示例 — 复制为 .env 后填入真实值
#
# LLM API 配置（多厂商兼容：DeepSeek / 通义 / Kimi / OpenAI 等 OpenAI 兼容接口）
AURORA_API_BASE=https://api.deepseek.com/v1
AURORA_API_KEY=sk-your-key-here
AURORA_MODEL=deepseek-chat
# AURORA_MODEL=deepseek-reasoner    # 含推理内容（reasoning_content）时开启

# Web 服务
AURORA_HOST=127.0.0.1
AURORA_PORT=8000